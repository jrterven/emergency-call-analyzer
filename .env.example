# Copy to .env. Files can be analyzed without an OpenAI key.
OPENAI_API_KEY=
LIVE_MODEL=gpt-live-1
SUMMARY_MODEL=gpt-6-luna
WHISPER_MODEL=small
EMOTION_MODEL=emotion2vec/emotion2vec_plus_base
# Optional Hugging Face commit hash; the resolved revision is included in exports.
EMOTION_MODEL_REVISION=main
MODEL_CACHE_DIR=.model-cache
DATA_DIR=data
TORCH_NUM_THREADS=4
